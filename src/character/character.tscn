[sub_resource type="GDScript" id="GDScript_e5t7k"]
resource_name = "character"
script/source = "extends CharacterBody2D

# Movement
@export var speed := 100.0
var move_direction := Vector2.ZERO
var facing_direction := Vector2.UP

# State
var is_trying_to_move := false
var is_interacting := false

# Animation
var current_anim := \"\"
@onready var animation_player := $AnimationPlayer

var interactables: Array[Interactable] = []
@onready var interaction_area := $InteractionArea

func _process(delta: float) -> void:
	handle_interaction_input()
	update_animation()
	if Input.is_action_just_pressed(\"interact\"):
		interact()

func _physics_process(delta: float) -> void:
	if is_interacting: return
	handle_movement()

func update_animation():
	if is_interacting:
		play_idle_animation(facing_direction)	
		return
		
	if is_trying_to_move:
		play_move_animation(facing_direction)
	else:
		play_idle_animation(facing_direction)	

func handle_movement():
	move_direction = Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")
	velocity = move_direction * speed
	is_trying_to_move = move_direction != Vector2.ZERO
	move_and_slide()
	
	if is_trying_to_move:
		facing_direction = move_direction

func play_animation(animation: String):
	if animation == current_anim:
		return
	
	current_anim = animation
	animation_player.play(animation)

func direction_to_anim(prefix: String, direction: Vector2):
	if abs(direction.x) > abs(direction.y):
		return prefix + (\"_right\" if direction.x > 0 else \"_left\")
	else:
		return prefix + (\"_down\" if direction.y > 0 else \"_up\")

func play_move_animation(direction: Vector2):
	play_animation(direction_to_anim(\"move\", direction))

func play_idle_animation(direction: Vector2):
	play_animation(direction_to_anim(\"idle\", direction))

func interact():
	if interactables.is_empty():
		return

	var best: Interactable = null
	var best_score := -1.0

	for i in interactables:
		var to_obj := (i.global_position - global_position).normalized()
		var facing_score := facing_direction.dot(to_obj)

		# Only allow interaction if facing object
		if facing_score > 0.6:
			if facing_score > best_score:
				best_score = facing_score
				best = i

	if best:
		is_interacting = true
		best.interact(self)

func handle_interaction_input():
	if Input.is_action_just_pressed(\"interact\") and not is_interacting:
		interact()

func finish_interaction():
	is_interacting = false

func _on_interaction_area_entered(area: Area2D) -> void:
	if area is Interactable:
		interactables.append(area)

func _on_interaction_area_exited(area: Area2D) -> void:
	if area is Interactable:
		interactables.erase(area)
"

