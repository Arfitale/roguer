[sub_resource type="GDScript" id="GDScript_w7mfs"]
resource_name = "Rat"
script/source = "extends CharacterBody2D

# State
enum EnemyState {
	IDLE,
	WANDER,
	ATTACK
}
var state := EnemyState.IDLE
var facing_direction := Vector2.UP

# Animation
@onready var animation_player := $AnimationPlayer

const speed = 300.0
const jump_velocity = -400.0

func _physics_process(delta: float) -> void:
	_handle_state()
	
func _handle_state():
	match state:
		EnemyState.IDLE:
			_handle_idle_state()
		
		EnemyState.WANDER:
			_handle_wander_state()
			
func _handle_idle_state():
	animation_player.play(\"idle_down\")

func _handle_wander_state():
	pass
"

