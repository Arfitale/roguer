[connection signal="dialogue_ended" from="." to="." method="_on_dialogue_ended"]
[connection signal="dialogue_started" from="." to="." method="_on_dialogue_started"]
[connection signal="dialogue_started" from="." to="DialogueUi" method="_on_dialogue_manager_dialogue_started"]
[connection signal="node_changed" from="." to="." method="_on_node_changed"]
[connection signal="node_changed" from="." to="DialogueUi" method="_on_dialogue_manager_node_changed"]
[connection signal="choice_selected" from="DialogueUi" to="." method="_on_dialogue_ui_choice_selected"]
[connection signal="typing_finished" from="DialogueUi" to="." method="_on_dialogue_ui_typing_finished"]
